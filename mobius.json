{
  "id": "atlas",
  "name": "Atlas",
  "version": "1.10.5",
  "description": "Spin the globe, tap the countries you've visited, and watch your map fill in.",
  "author": "mobius-os",
  "license": "MIT AND CC-BY-3.0-IGO",
  "homepage": "https://github.com/mobius-os/app-atlas",
  "entry": "index.jsx",
  "icon": "icon-v2.png",
  "theme_color": "#101820",
  "background_color": "#101820",
  "offline_capable": true,
  "permissions": {
    "cross_app_access": "none",
    "share_with_apps": "none"
  },
  "storage_seeds": {
    "visited.json": [],
    "wishlist.json": [],
    "countries.geo.json": "countries.geo.json",
    "textures/blue-marble-2004-10-4096.webp": "assets/blue-marble-2004-10-4096.webp",
    "textures/blue-marble-2004-10-2048.webp": "assets/blue-marble-2004-10-2048.webp"
  },
  "offline": {
    "reads": true,
    "writes": "queued",
    "execution": "full",
    "precache": [
      "countries.geo.json"
    ]
  },
  "runtime": {
    "imports": [
      "react",
      "react-dom",
      "@openai/apps-sdk-ui/components/Icon"
    ],
    "esm_deps": [
      "d3-geo"
    ]
  },
  "source_files": [
    "constants.js",
    "theme.js",
    "domain.js",
    "storage.js",
    "sync.js",
    "earthTexture.js",
    "ui/Globe.jsx",
    "ui/BottomSheet.jsx",
    "ui/SyncPill.jsx",
    "ui/earthRenderer.js"
  ]
}

{
  "id": "atlas",
  "name": "Atlas",
  "version": "1.6.1",
  "description": "Spin and zoom the globe, tap a country, mark it visited. Watch your atlas fill up as the count climbs.",
  "author": "mobius-os",
  "license": "MIT",
  "homepage": "https://github.com/mobius-os/app-atlas",
  "entry": "index.jsx",
  "icon": "icon.png",
  "offline_capable": true,
  "permissions": {
    "cross_app_access": "none",
    "share_with_apps": "none"
  },
  "storage_seeds": {
    "visited.json": [],
    "wishlist.json": [],
    "countries.geo.json": "countries.geo.json"
  },
  "runtime": {
    "imports": [
      "react",
      "react-dom"
    ],
    "esm_deps": [
      "d3-geo"
    ]
  }
}

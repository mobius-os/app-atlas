{
  "id": "atlas",
  "name": "Atlas",
  "version": "1.7.0",
  "description": "Spin the globe, tap the countries you've visited, and watch your map fill in.",
  "author": "mobius-os",
  "license": "MIT",
  "homepage": "https://github.com/mobius-os/app-atlas",
  "entry": "index.jsx",
  "icon": "icon.png",
  "theme_color": "#101820",
  "background_color": "#101820",
  "offline_capable": true,
  "permissions": {
    "cross_app_access": "none",
    "share_with_apps": "none"
  },
  "storage_seeds": {
    "visited.json": [],
    "wishlist.json": [],
    "countries.geo.json": "countries.geo.json"
  },
  "offline": {
    "reads": true,
    "writes": "queued",
    "execution": "full",
    "precache": ["countries.geo.json"]
  },
  "runtime": {
    "imports": [
      "react",
      "react-dom"
    ],
    "esm_deps": [
      "d3-geo"
    ]
  }
}